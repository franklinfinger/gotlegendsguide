  "targets": [
    {"id":"legendary-assault:drogon","battleMode":"legendary-assault","kind":"encounter","name":"Drogon","evidenceState":"verified","approach":"Bring BIRTHRIGHT and fast Skill access, keep using Skills, and rely on damage Drogon does not ignore.","timing":"Use at least one Skill each turn when possible. Avoid making Power-Up destruction and shields the center of the plan.","warning":"Drogon is immune to FIRE and destroys shields; his attacks can also reduce the Treasury.","provenanceRef":"legendary_assault_encounter:drogon"},
    {"id":"legendary-assault:rhaegal","battleMode":"legendary-assault","kind":"encounter","name":"Rhaegal","evidenceState":"verified","approach":"Stack BLEED and FIRE while protecting and healing the champion Rhaegal forces to TAUNT.","timing":"Apply BLEED before Rhaegal uses his Skill and keep FIRE active. Do not reinforce into his 100% HP Pool retaliation.","warning":"Rhaegal consumes BIRTHRIGHT, FURY, shields, ICE, and BRITTLE; he cannot be STUNNED, PACIFIED, or DECEIVED.","provenanceRef":"legendary_assault_encounter:rhaegal"},
